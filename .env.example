NODE_ENV=dev
PORT=3000
JWT_SECRET=super-strong-secret
# JWT expiry duration (e.g. 15m, 1h, 24h, 7d — default: 24h)
JWT_EXPIRES_IN=24h
MONGODB_URI=mongodb://127.0.0.1:27017/rc_db
CLIENT_ORIGIN=http://localhost:3001
# Trust proxy hop count — set to 1 when behind nginx/load balancer, 0 for direct connections
TRUST_PROXY=0

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
# AI request timeout in milliseconds (default: 15 seconds)
AI_TIMEOUT_MS=15000

# Rate Limiter Configuration
# 15 minutes
RATE_LIMIT_WINDOW_MS=900000
# max 100 requests per window
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MESSAGE=Too many requests from this IP, please try again later.
RATE_LIMIT_STATUS_CODE=429
